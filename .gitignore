# Local .terraform directories (plugins and modules cache)
**/.terraform/*

# .tfstate files (may contain sensitive data/passwords/keys)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local customizations
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files for terraform cloud/enterprise if desired:
# !override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Private Keys
*.pem
*.key
